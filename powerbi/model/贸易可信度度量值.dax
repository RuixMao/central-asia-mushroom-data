已确认贸易额 = SUM('贸易可信度'[已确认贸易额美元])

来自中国金额 = SUM('贸易可信度'[来自中国金额美元])

中国供应占比 = DIVIDE([来自中国金额], [已确认贸易额])

已确认数量 = SUM('贸易可信度'[数量公斤])

覆盖国家数 = DISTINCTCOUNT('贸易可信度'[国家])

A+记录数 = CALCULATE(COUNTROWS('贸易可信度'), '贸易可信度'[可信度等级] = "A+")

B+记录数 = CALCULATE(COUNTROWS('贸易可信度'), '贸易可信度'[可信度等级] = "B+")

加权可信度 = DIVIDE(SUM('贸易可信度'[可信度排序]), COUNTROWS('贸易可信度'))
