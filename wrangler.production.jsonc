{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yinheng-platform",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "yinheng.site",
      "custom_domain": true
    }
  ],
  "vars": {
    "AI_BASE_URL": "https://api.deepseek.com",
    "AI_MODEL": "deepseek-v4-flash",
    "AI_PROVIDER": "deepseek"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yinheng-market-data",
      "database_id": "dc6f6cc2-6611-4ce7-be0f-3be4357b9fef",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
